  "about": {
    "since": "Since 2014",
    "heroTitle": "Our Mission:",
    "heroTitleHighlight": "Connecting the Indian Ocean",
    "heroSubtitle": "OceanicJob was born from a dream: to help young graduates from Madagascar, Comoros, Mauritius and all Indian Ocean islands find employment with dignity, without corruption, without favoritism.",
    "ourStory": "Our Story",
    "storyPart1": "OceanicJob is much more than a job platform. It's a social mission born in 2014 thanks to the vision of Noureddine ABDALLAH, who dreamed of connecting Indian Ocean talents to the world of work.",
    "storyPart2": "Today, taken over and improved by Sidi ABDILLAH SIDI and Ibrahim DJOUMOI, OceanicJob continues this mission with modern technology and renewed ambition.",
    "storyQuote": "In Madagascar and the islands, many brilliant young graduates cannot find work. Not because they lack skills, but because they don't know 'someone's uncle'. We want to change that.",
