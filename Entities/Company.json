{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo URL"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "size": {
      "type": "string",
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1000+"
      ],
      "description": "Company size"
    },
    "location": {
      "type": "string",
      "description": "Company headquarters location"
    },
    "website": {
      "type": "string",
      "description": "Company website URL"
    },
    "description": {
      "type": "string",
      "description": "Company description"
    },
    "culture": {
      "type": "string",
      "description": "Company culture and values"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Company benefits offered"
    }
  },
  "required": [
    "name"
  ]
}